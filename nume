<script>
  // ── Cursor glow ──
  const glow = document.getElementById('cursorGlow');
  document.addEventListener('mousemove', e => {
    glow.style.left = e.clientX + 'px';
    glow.style.top = e.clientY + 'px';
  });

  // ── Nav scroll ──
  const navbar = document.getElementById('navbar');
  window.addEventListener('scroll', () => {
    navbar.classList.toggle('scrolled', window.scrollY > 40);
  });

  // ── Hamburger ──
  const hamburger = document.getElementById('hamburger');
  const navLinks = document.getElementById('navLinks');
  hamburger.addEventListener('click', () => {
    navLinks.classList.toggle('open');
  });
  navLinks.querySelectorAll('a').forEach(a => {
    a.addEventListener('click', () => navLinks.classList.remove('open'));
  });

  // ── Intersection Observer ──
  const reveals = document.querySelectorAll('.reveal');
  const io = new IntersectionObserver((entries) => {
    entries.forEach((e, i) => {
      if (e.isIntersecting) {
        setTimeout(() => e.target.classList.add('visible'), i * 80);
        io.unobserve(e.target);
      }
    });
  }, { threshold: 0.12 });
  reveals.forEach(r => io.observe(r));

  // ── Count up ──
  const counters = document.querySelectorAll('.count-up');
  let counted = false;
  const heroSection = document.getElementById('hero');
  const counterIO = new IntersectionObserver((entries) => {
    if (entries[0].isIntersecting && !counted) {
      counted = true;
      counters.forEach(el => {
        const target = +el.dataset.target;
        const duration = 1800;
        const step = target / (duration / 16);
        let current = 0;
        const timer = setInterval(() => {
          current = Math.min(current + step, target);
          el.textContent = Math.floor(current);
          if (current >= target) clearInterval(timer);
        }, 16);
      });
    }
  }, { threshold: 0.5 });
  counterIO.observe(heroSection);

  // ── Metric bars animation ──
  const bars = document.querySelectorAll('.metric-bar');
  const barIO = new IntersectionObserver((entries) => {
    entries.forEach(e => {
      if (e.isIntersecting) {
        bars.forEach(b => {
          b.style.width = b.dataset.width;
        });
        barIO.unobserve(e.target);
      }
    });
  }, { threshold: 0.5 });
  const metricsPanel = document.querySelector('.metrics-panel');
  if (metricsPanel) barIO.observe(metricsPanel);

  // ── CTA button ──
  function handleCTA() {
    const input = document.querySelector('.cta-input');
    const btn = document.getElementById('ctaBtn');
    if (input.value && input.value.includes('@')) {
      btn.textContent = '✓ Mesaj trimis!';
      btn.style.background = '#1dd1a1';
      input.value = '';
      setTimeout(() => {
        btn.textContent = 'Rezervă demo →';
        btn.style.background = '';
      }, 3000);
    } else {
      input.style.borderColor = 'var(--danger)';
      input.placeholder = 'Introduceți un email valid';
      setTimeout(() => {
        input.style.borderColor = '';
        input.placeholder = 'Adresa ta de email';
      }, 2500);
    }
  }

  // ── Enter key for CTA ──
  document.querySelector('.cta-input').addEventListener('keydown', e => {
    if (e.key === 'Enter') handleCTA();
  });
</script>
